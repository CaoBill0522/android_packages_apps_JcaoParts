<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.jcao.parts">

    <!-- Needed to start DitingEsim's switch activity -->
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />

    <application
        android:label="@string/jcao_title"
        android:icon="@drawable/ic_jcao"
        android:allowBackup="false"
        android:theme="@style/Theme.SubSettingsBase">

        <!-- Injected into Settings > System > Advanced, below Developer options -->
        <activity
            android:name=".JcaoSettingsActivity"
            android:exported="true"
            android:label="@string/jcao_title">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="advanced_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="100" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_jcao" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/jcao_summary" />
        </activity>
    </application>
</manifest>
